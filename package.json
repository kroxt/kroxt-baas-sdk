{
  "name": "@kroxt/baas-sdk",
  "version": "1.0.4",
  "description": "Official JavaScript/TypeScript SDK for Kroxt BaaS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kroxt",
    "baas",
    "sdk",
    "client",
    "realtime",
    "auth",
    "database"
  ],
  "author": "Kroxt Team",
  "license": "MIT",
  "homepage": "https://github.com/kroxt/kroxt-baas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kroxt/kroxt-baas.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/kroxt/kroxt-baas/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "form-data": "^4.0.6",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "@types/node": "^20.12.7"
  }
}
